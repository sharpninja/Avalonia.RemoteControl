<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Avalonia.RemoteControl.AndroidProbe.Views.ProbeView"
             x:Name="ProbeRoot"
             Name="ProbeRoot">
  <Grid RowDefinitions="Auto,*"
        Margin="24"
        RowSpacing="16">
    <TextBlock Text="Android bridge probe"
               FontSize="22"
               FontWeight="SemiBold" />

    <StackPanel Grid.Row="1"
                Spacing="12">
      <TextBlock Text="Editable probe value" />
      <TextBox Name="ProbeEditableText"
               Text="Initial Android probe text" />
      <Button Name="ProbeActionButton"
              Content="Probe Button"
              HorizontalAlignment="Left" />
    </StackPanel>
  </Grid>
</UserControl>
