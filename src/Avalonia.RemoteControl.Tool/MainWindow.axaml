<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tool="using:Avalonia.RemoteControl.Tool"
        x:Class="Avalonia.RemoteControl.Tool.MainWindow"
        Title="Avalonia Remote Control"
        Width="1180"
        Height="760"
        MinWidth="920"
        MinHeight="560"
        Classes="vs-shell">
  <Grid RowDefinitions="Auto,*" Background="{StaticResource VsShellBackgroundBrush}">
    <Border Grid.Row="0" Classes="vs-command-bar">
      <Grid RowDefinitions="Auto,Auto,Auto"
            ColumnDefinitions="Auto,*,220,180,Auto,Auto,Auto,Auto,Auto,Auto"
            ColumnSpacing="8"
            RowSpacing="8"
            VerticalAlignment="Center">
        <TextBlock Text="Endpoint" VerticalAlignment="Center" />
        <TextBox x:Name="EndpointBox"
                 Grid.Column="1"
                 Text="http://127.0.0.1:47100"
                 PlaceholderText="http://127.0.0.1:47100" />
        <TextBox x:Name="TokenBox"
                 Grid.Column="2"
                 PasswordChar="*"
                 PlaceholderText="Bearer token" />
        <TextBox x:Name="CertificatePathBox"
                 Grid.Column="3"
                 PlaceholderText="Certificate path" />
        <Button Grid.Column="4" Classes="vs-tool-button" Content="Connect" Click="ConnectClicked" />
        <Button Grid.Column="5" Classes="vs-tool-button" Content="Snapshot" Click="RefreshSnapshotClicked" />
        <Button x:Name="LogToggleButton" Grid.Column="6" Classes="vs-tool-button" Content="Logs" Click="ToggleLogsClicked" />
        <Button Grid.Column="7" Classes="vs-tool-button" Content="Live View" Click="OpenLiveViewClicked" />
        <Button Grid.Column="8" Classes="vs-tool-button" Content="Save" Click="SaveProfileClicked" />
        <Button Grid.Column="9" Classes="vs-tool-button" Content="Forget" Click="ForgetProfileClicked" />

        <TextBlock Grid.Row="1" Text="Accepted SHA-256" VerticalAlignment="Center" />
        <TextBox x:Name="AcceptedFingerprintBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 Grid.ColumnSpan="3"
                 IsReadOnly="True"
                 PlaceholderText="Accepted certificate fingerprint" />
        <Button Grid.Row="1" Grid.Column="4" Classes="vs-tool-button" Content="Inspect Cert" Click="InspectCertificateClicked" />
        <Button Grid.Row="1" Grid.Column="5" Classes="vs-tool-button" Content="Accept Cert" Click="AcceptCertificateClicked" />
        <Button Grid.Row="1" Grid.Column="6" Classes="vs-tool-button" Content="Reject Cert" Click="RejectCertificateClicked" />
        <ComboBox x:Name="TransportProtocolBox"
                  Grid.Row="1"
                  Grid.Column="7"
                  Grid.ColumnSpan="3"
                  MinWidth="150" />

        <TextBlock Grid.Row="2" Text="Android ADB" VerticalAlignment="Center" />
        <TextBox x:Name="AdbPathBox"
                 Grid.Row="2"
                 Grid.Column="1"
                 PlaceholderText="adb.exe path (optional)" />
        <ComboBox x:Name="AdbDeviceBox"
                  Grid.Row="2"
                  Grid.Column="2"
                  MinWidth="220"
                  PlaceholderText="Device" />
        <TextBox x:Name="AdbPackageBox"
                 Grid.Row="2"
                 Grid.Column="3"
                 PlaceholderText="Package name" />
        <TextBox x:Name="AdbHostPortBox"
                 Grid.Row="2"
                 Grid.Column="4"
                 Width="84"
                 Text="47100"
                 PlaceholderText="Port" />
        <Button Grid.Row="2" Grid.Column="5" Classes="vs-tool-button" Content="Refresh Devices" Click="RefreshAdbDevicesClicked" />
        <Button Grid.Row="2" Grid.Column="6" Classes="vs-tool-button" Content="Android Connect" Click="AndroidConnectClicked" />
        <Button Grid.Row="2" Grid.Column="7" Classes="vs-tool-button" Content="Cleanup Forward" Click="CleanupAdbForwardClicked" />
      </Grid>
    </Border>

    <tool:DockLayout x:Name="WorkspaceDockLayout"
                     Grid.Row="1"
                     Background="{StaticResource VsDockSeparatorBrush}"
                     DockSpacing="5"
                     WestWidth="340"
                     EastWidth="390"
                     SouthHeight="220"
                     Margin="0,0,0,24">
      <tool:DockPaneChrome x:Name="ControlTreePane"
                           tool:DockLayout.Region="West"
                           PanelId="controlTree"
                           Title="Control Tree"
                           Glyph="&#xE8B7;"
                           CommandRequested="DockPaneCommandRequested"
                           HeaderDragCompleted="DockPaneHeaderDragCompleted">
        <tool:DockPaneChrome.Body>
          <tool:ControlTreePanel x:Name="ControlTreePanel" />
        </tool:DockPaneChrome.Body>
      </tool:DockPaneChrome>

      <tool:DockPaneChrome x:Name="RemoteToolsPane"
                           tool:DockLayout.Region="East"
                           PanelId="remoteTools"
                           Title="Remote Tools"
                           Glyph="&#xE713;"
                           CommandRequested="DockPaneCommandRequested"
                           HeaderDragCompleted="DockPaneHeaderDragCompleted">
        <tool:DockPaneChrome.Body>
          <tool:RemoteToolsPanel x:Name="RemoteToolsPanel" />
        </tool:DockPaneChrome.Body>
      </tool:DockPaneChrome>

      <tool:DockPaneChrome x:Name="LogsPane"
                           tool:DockLayout.Region="South"
                           PanelId="logs"
                           Title="Logs"
                           Glyph="&#xE8A5;"
                           CommandRequested="DockPaneCommandRequested"
                           HeaderDragCompleted="DockPaneHeaderDragCompleted">
        <tool:DockPaneChrome.Body>
          <tool:LogPanel x:Name="DockedLogPanel" IsDockHost="True" />
        </tool:DockPaneChrome.Body>
      </tool:DockPaneChrome>

      <tool:DockPaneChrome x:Name="WorkspacePane"
                           PanelId="workspace"
                           Title="Workspace"
                           Glyph="&#xE756;"
                           CommandRequested="DockPaneCommandRequested"
                           HeaderDragCompleted="DockPaneHeaderDragCompleted">
        <tool:DockPaneChrome.Body>
          <tool:WorkspacePanel x:Name="WorkspacePanel" />
        </tool:DockPaneChrome.Body>
      </tool:DockPaneChrome>
    </tool:DockLayout>

    <Border Grid.Row="1" Classes="vs-status-bar" VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
      <TextBlock x:Name="StatusText" Text="Disconnected" />
    </Border>
  </Grid>
</Window>
