<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tool="using:Avalonia.RemoteControl.Tool"
             x:Class="Avalonia.RemoteControl.Tool.PropertiesPanel"
             x:DataType="tool:PropertiesPanelViewModel">
  <ListBox x:Name="Rows"
           Classes="vs-tool-list"
           ItemsSource="{Binding Rows}"
           SelectionChanged="RowsSelectionChanged" />
</UserControl>
