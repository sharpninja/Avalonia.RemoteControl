<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tool="using:Avalonia.RemoteControl.Tool"
             x:Class="Avalonia.RemoteControl.Tool.ProjectPanel"
             x:DataType="tool:ProjectPanelViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="8" Margin="8">
    <TextBlock Text="Project" FontWeight="SemiBold" />
    <TextBlock Grid.Row="1"
               TextWrapping="Wrap"
               Text="{Binding SummaryText}" />
    <TextBlock Grid.Row="2"
               TextWrapping="Wrap"
               Text="{Binding SessionText}" />
    <TextBlock Grid.Row="3"
               TextWrapping="Wrap"
               Text="{Binding ReplayText}" />
    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
      <Button Classes="vs-tool-button" Content="Save Project" Click="SaveProjectClicked" />
      <Button Classes="vs-tool-button" Content="Refresh" Click="RefreshClicked" />
    </StackPanel>
  </Grid>
</UserControl>
