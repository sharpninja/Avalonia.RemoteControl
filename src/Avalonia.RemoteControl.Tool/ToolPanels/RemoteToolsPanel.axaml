<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tool="using:Avalonia.RemoteControl.Tool"
             x:Class="Avalonia.RemoteControl.Tool.RemoteToolsPanel"
             x:DataType="tool:RemoteToolsPanelViewModel">
  <TabControl x:Name="Tabs"
              SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
              SelectionChanged="TabsSelectionChanged">
    <TabItem Header="Actions">
      <tool:ActionsPanel x:Name="ActionsPanel" />
    </TabItem>
    <TabItem Header="Live View">
      <tool:DockPaneChrome x:Name="LiveViewChrome"
                           PanelId="liveView"
                           Title="Live View"
                           Glyph="&#xE8A7;"
                           CanDock="False"
                           CommandRequested="LiveViewChromeCommandRequested"
                           HeaderDragCompleted="LiveViewChromeHeaderDragCompleted">
        <tool:DockPaneChrome.Body>
          <tool:LiveViewPanel x:Name="LiveViewPanel" />
        </tool:DockPaneChrome.Body>
      </tool:DockPaneChrome>
    </TabItem>
    <TabItem Header="Project">
      <tool:ProjectPanel x:Name="ProjectPanel" />
    </TabItem>
  </TabControl>
</UserControl>
