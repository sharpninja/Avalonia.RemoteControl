<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>avalonia-remote</ToolCommandName>
    <PackageId>Avalonia.RemoteControl.Tool</PackageId>
    <Title>Avalonia Remote Control Tool</Title>
    <Description>Command-line launcher for the Avalonia Remote Control client.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <ProjectReference Include="..\Avalonia.RemoteControl.Client\Avalonia.RemoteControl.Client.csproj" />
    <ProjectReference Include="..\Avalonia.RemoteControl.Protocol\Avalonia.RemoteControl.Protocol.csproj" />
  </ItemGroup>
</Project>
