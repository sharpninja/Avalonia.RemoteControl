<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tool="using:Avalonia.RemoteControl.Tool"
        x:Class="Avalonia.RemoteControl.Tool.FloatingDockPaneWindow"
        Title="Avalonia Remote Control Panel"
        Width="520"
        Height="420"
        MinWidth="320"
        MinHeight="220"
        Classes="vs-shell">
  <tool:DockPaneChrome x:Name="Chrome"
                       IsFloating="True"
                       CanDock="True"
                       CommandRequested="ChromeCommandRequested" />
</Window>
