<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Avalonia.RemoteControl.Tool.RemoteViewControl">
  <Grid RowDefinitions="Auto,*" Background="{StaticResource VsShellBackgroundBrush}">
    <Border Grid.Row="0" Classes="vs-tool-window-header">
      <ScrollViewer HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="ScreenshotModeButton" Classes="vs-tool-button" Content="Screenshot" Click="ScreenshotModeClicked" />
          <Button x:Name="TreeModeButton" Classes="vs-tool-button" Content="Tree Replica" Click="TreeModeClicked" />
          <CheckBox x:Name="OverlayCheckBox" Content="Overlay" IsChecked="True" Click="OverlayChanged" />
          <TextBlock x:Name="StatusText"
                     Classes="vs-muted"
                     Text="Connecting..."
                     VerticalAlignment="Center" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border x:Name="ViewportBorder"
            Grid.Row="1"
            Background="#111111"
            ClipToBounds="True"
            Focusable="True"
            PointerPressed="ViewportPointerPressed"
            PointerReleased="ViewportPointerReleased"
            PointerMoved="ViewportPointerMoved"
            PointerWheelChanged="ViewportPointerWheelChanged"
            KeyDown="ViewportKeyDown"
            KeyUp="ViewportKeyUp"
            TextInput="ViewportTextInput">
      <Grid>
        <Image x:Name="FrameImage" Stretch="Uniform" />
        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
